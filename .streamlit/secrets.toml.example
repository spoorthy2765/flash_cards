# =========================================================
# Smart Flashcards - secrets template
# =========================================================
# NEVER commit the real file. `.streamlit/secrets.toml` is already
# listed in .gitignore, so it can never leak into your repository.
#
# 1) LOCAL USE
#    Copy this file to `.streamlit/secrets.toml` and fill in your key.
#
# 2) STREAMLIT COMMUNITY CLOUD (free hosting)
#    Paste the block below into the "Secrets" field of the
#    "Advanced settings" dialog while deploying (or later via
#    App -> Settings -> Secrets). Community Cloud does NOT create
#    environment variables, so st.secrets is the only channel that
#    reaches the app. The code in services/ai_service.py reads both.
#
# 3) RENDER / HUGGING FACE / DOCKER / OTHER HOSTS
#    Add the same names as real environment variables in the host's
#    dashboard (the code falls back to os.getenv automatically).
# =========================================================

# --- Google Gemini (recommended - generous free tier) -------------------
# Get a free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY = "paste_your_real_gemini_key_here"

# --- OpenAI (optional alternative) ---------------------------------------
# Only uncomment this if you are NOT using Gemini above; the app picks
# Gemini first, then OpenAI.
# OPENAI_API_KEY = "paste_your_real_openai_key_here"
