# =========================================================
# Smart Flashcards - API Configuration
# =========================================================

# Option 1: OpenAI API Key (gpt-4o-mini)
OPENAI_API_KEY=your_api_key_here

# Option 2: Google Gemini API Key (gemini-3.8-flash)
# Free key available at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Note: If no API key is provided, the platform automatically runs
# in "Demo Mode" with curated college exam flashcard datasets.
